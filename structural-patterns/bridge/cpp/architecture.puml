@startuml
title Design Pattern 7 - Bridge Drawing Application

interface Renderer <<Implementor>> {
    + ~Renderer()
    + render(shape_name : std::string_view) const : void
}

class VectorRenderer <<Concrete Implementor>> {
    + render(shape_name : std::string_view) const : void
}

class RasterRenderer <<Concrete Implementor>> {
    + render(shape_name : std::string_view) const : void
}

class AsciiRenderer <<Concrete Implementor>> {
    + render(shape_name : std::string_view) const : void
}

abstract class Shape <<Abstraction>> {
    # renderer_ : Renderer&
    + Shape(renderer : Renderer&)
    + ~Shape()
    + draw() const : void
}

class Circle <<Refined Abstraction>> {
    + Circle(renderer : Renderer&)
    + draw() const : void
}

class Square <<Refined Abstraction>> {
    + Square(renderer : Renderer&)
    + draw() const : void
}

class Triangle <<Refined Abstraction>> {
    + Triangle(renderer : Renderer&)
    + draw() const : void
}

Renderer <|.. VectorRenderer
Renderer <|.. RasterRenderer
Renderer <|.. AsciiRenderer

Shape <|-- Circle
Shape <|-- Square
Shape <|-- Triangle

Shape --> Renderer : renderer_ / bridge

@enduml
