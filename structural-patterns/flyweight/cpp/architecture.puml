
@startuml
title Flyweight Pattern - Text Editor

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle

top to bottom direction

' ==========================================================
' Abstract Flyweight
' ==========================================================

interface Flyweight <<Flyweight>> {
    + render(value : char, highlighted : bool) : void
}

' ==========================================================
' Concrete Flyweight
' ==========================================================

class CharacterStyle <<Concrete Flyweight>> {
    - bold_ : const bool
    - italic_ : const bool
    - color_ : const string
    --
    - {static} validate_color(color : string_view) : void
    + CharacterStyle(bold : bool, italic : bool, color : string)
    + render(value : char, highlighted : bool) : void
}

' ==========================================================
' Flyweight Key
' ==========================================================

class StyleKey <<Value Object>> {
    + bold : bool
    + italic : bool
    + color : string
    --
    + operator<=>(other : const StyleKey&) : auto
}

' ==========================================================
' Flyweight Factory
' ==========================================================

class StyleFactory <<Flyweight Factory>> {
    - styles_ : map<StyleKey, unique_ptr<const Flyweight>>
    --
    + getStyle(bold : bool, italic : bool, color : string_view) : const Flyweight*
    + styleCount() : size_t
}

' ==========================================================
' Context
' ==========================================================

class Character <<Context>> {
    - value_ : char
    - style_ : const Flyweight*
    --
    - {static} validate_style(style : const Flyweight*) : void
    + Character(value : char, style : const Flyweight*)
    + display(highlighted : bool) : void
}

' ==========================================================
' Client / Text Editor
' ==========================================================

class TextEditor <<Client / Coordinator>> {
    - styleFactory_ : StyleFactory
    - characters_ : vector<Character>
    - highlightedPositions_ : set<size_t>
    --
    + TextEditor()
    + addCharacter(value : char, bold : bool, italic : bool, color : string_view) : void
    + highlight(position : size_t) : void
    + removeHighlight(position : size_t) : void
    + display() : void
    + styleCount() : size_t
}

' ==========================================================
' Relationships
' ==========================================================

' Concrete Flyweight implements the abstract interface.
Flyweight <|.. CharacterStyle

' Factory exclusively owns the cached Flyweights.
StyleFactory "1" *-- "0..*" Flyweight : owns / caches

' Factory uses keys to identify unique styles.
StyleFactory ..> StyleKey : cache key

' Factory constructs the concrete implementation.
StyleFactory ..> CharacterStyle : creates

' Many characters may reference the same Flyweight.
Character "0..*" --> "1" Flyweight : non-owning reference

' TextEditor owns the factory and character collection.
TextEditor "1" *-- "1" StyleFactory : owns
TextEditor "1" *-- "0..*" Character : contains

' ==========================================================
' Design Notes
' ==========================================================

note right of CharacterStyle
    INTRINSIC STATE

    - bold
    - italic
    - color

    Shared and immutable.

    Identical formatting can
    reuse one Flyweight instance.
end note

note right of Character
    CONTEXT

    Stores the character value
    and a non-owning pointer
    to its shared Flyweight.

    Delegates rendering through
    the abstract interface.
end note

note right of StyleFactory
    OWNERSHIP

    Stores unique_ptr<const Flyweight>.

    Identical StyleKey values
    return the same instance.

    getStyle() returns a
    non-owning const Flyweight*.
end note

note bottom of TextEditor
    DYNAMIC HIGHLIGHTING

    Highlighted positions are
    stored separately in a set.

    Highlighting is supplied
    as extrinsic state at runtime.

    No new Flyweights are created
    when highlighting changes.

    Copying and moving are disabled.
end note

@enduml
