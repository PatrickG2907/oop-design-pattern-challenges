from dataclasses import dataclass
from abc import ABC, abstractmethod
from typing import Optional

#------------------------------------
# Configuration
#------------------------------------
LEVELS = {"low", "medium", "high", "critical"}
TAGS = {"urgent", "vip", "security"}

#------------------------------------
# Request
#------------------------------------
@dataclass
class Request:
    severity: str
    name: str
    tag: str = None  # optional
    
    def __post_init__(self) -> None:
        if self.severity not in LEVELS:
            raise ValueError(f"Invalid severity '{self.severity}', must be one of {LEVELS}!")
        if not self.name:
            raise ValueError("Request name cannot be empty!")
        if self.tag and self.tag not in TAGS:
            raise ValueError(f"Invalid tag '{self.tag}', must be one of {TAGS}!")

# ------------------------------------
# Notifier Interface
# ------------------------------------
class Notifier(ABC):
    @abstractmethod
    def notify_handled(self, handler_name: str, request: Request) -> None:
        pass
    
    @abstractmethod
    def notify_routing(self, request: Request) -> None:
        pass
    
    @abstractmethod
    def notify_skipped(self, handler_name: str, request: Request) -> None:
        pass
    
    @abstractmethod
    def notify_error(self, request: Request) -> None:
        pass
    
class ConsoleNotifier(Notifier):
    def notify_handled(self, handler_name: str, request: Request) -> None:
        print(f"[HANDLED] {handler_name} processed request '{request.name}'")
        print("\n")

    def notify_routing(self, request: Request) -> None:
        print(f"[Routing] Received request '{request.name}' with severity '{request.severity}' and tag '{request.tag}'")

    def notify_skipped(self, handler_name: str, request: Request) -> None:
        print(f"[SKIPPED] {handler_name} skipped request '{request.name}'")

    def notify_error(self, request: Request) -> None:
        print(f"[Error] Unable to handle request '{request.name}'")

#------------------------------------
# Handler (Chain of Responsibility)
#------------------------------------
class AbstractHandler(ABC):
    def __init__(self, successor: Optional["AbstractHandler"] = None) -> None:
        self.successor = successor

    @abstractmethod
    def handle(self, request: Request) -> None:
        pass

class Handler(AbstractHandler):
    def __init__(self, name: str, supported_levels: set[str], successor: AbstractHandler = None, notifier: Notifier = None) -> None:
        super().__init__(successor)
        self._name = name
        self._supported_levels = supported_levels
        self._notifier = notifier

    def handle(self, request: Request) -> None:
        if request.severity in self._supported_levels:
            # Delegate notification
            if self._notifier:
                self._notifier.notify_handled(self._name, request)
        elif self.successor:
            if self._notifier:
                self._notifier.notify_skipped(self._name, request)
            self.successor.handle(request)
        else:
            if self._notifier:
                self._notifier.notify_skipped(self._name, request)
                self._notifier.notify_error(request)
            
#------------------------------------
# Router (Tag-based entry)
#------------------------------------
class Router:
    def __init__(self, default_handler: AbstractHandler, level_map: dict[str, AbstractHandler], tag_overrides: dict[str, str], notifier: Notifier) -> None:
        self.default_handler = default_handler  # usually level1
        self.level_map = level_map
        self.tag_overrides = tag_overrides
        self.notifier = notifier

    def route(self, request: Request) -> None:
        if self.notifier:
            self.notifier.notify_routing(request)

        if request.tag and request.tag in self.tag_overrides:
            # Tag override: jump directly to the handler for the overridden severity
            severity = self.tag_overrides[request.tag]
            handler = self.level_map[severity]
            request.severity = severity
            handler.handle(request)
        else:
            # No tag: start at the default handler (lowest level)
            self.default_handler.handle(request)

#------------------------------------
# Build handler chain
#------------------------------------
notifier = ConsoleNotifier()

# Handlers
level3 = Handler("Level3", {"high"}, notifier=notifier)
level2 = Handler("Level2", {"medium"}, successor=level3, notifier=notifier)
level1 = Handler("Level1", {"low"}, successor=level2, notifier=notifier)

# Unified router
TAG_OVERRIDES = {"urgent": "high", "vip": "medium"}
level_map = {"low": level1, "medium": level2, "high": level3}
router = Router(level1, level_map, TAG_OVERRIDES, notifier)

# Requests
req1 = Request(severity="high", name="Password Reset")
req2 = Request(severity="medium", name="Server Down", tag="urgent")
req3 = Request(severity="low", name="VIP Inquiry", tag="vip")
req4 = Request(severity="critical", name="Malware")

# Route requests
for req in [req1, req2, req3, req4]:
    router.route(req)
